# .env.example
# Instrukcja: Skopiuj ten plik do pliku o nazwie .env i uzupełnij poniższe dane.

# 1. Konfiguracja bazy danych (PostgreSQL)
# DB_USER: Nazwa użytkownika bazy danych (zdefiniowana w docker-compose.yml, np. 'root')
DB_USER=
# DB_PASSWORD: Hasło do bazy danych (ustaw silne hasło, zgodne z docker-compose.yml)
DB_PASSWORD=
# DB_NAME: Nazwa Twojej bazy danych (np. 'territorium_db')
DB_NAME=
# DB_HOST: Nazwa hosta bazy w sieci Dockera (zazwyczaj nazwa usługi, czyli 'db')
DB_HOST=
# DB_PORT: Port bazy danych wewnątrz sieci Dockera (standardowo 5432)
DB_PORT=5432

# 2. Port serwera Node.js
# Port, na którym aplikacja backendowa będzie nasłuchiwać (np. 3000)
PORT=3000

# 3. Klucz szyfrowania (JWT)
# JWT_SECRET: Bardzo długi, unikalny ciąg znaków używany do podpisywania tokenów.
# Powinien być trudny do odgadnięcia (np. wygenerowany losowo).
JWT_SECRET=